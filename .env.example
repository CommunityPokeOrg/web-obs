# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# WebSocket URL of the control relay server (server/server.mjs).
# Leave empty to use BroadcastChannel only (remote control works between tabs
# on the same browser, same origin).
VITE_CONTROL_WS_URL=ws://localhost:8480/control

# Room name the studio joins. Controllers must use the same room.
VITE_ROOM=default

# Shared secret used to authenticate against the relay server.
# Must match WEB_OBS_TOKEN on the server.
VITE_TOKEN=dev-token

# Optional: media bridge endpoint that receives the program feed for
# recording / RTMP restreaming. Leave empty to disable.
VITE_BRIDGE_WS_URL=ws://localhost:8480/bridge

# Optional: WHIP endpoint for direct WebRTC ingest (e.g. MediaMTX, Cloudflare
# Stream, Dolby.io). Leave empty to disable.
VITE_WHIP_URL=
VITE_WHIP_TOKEN=

# ── Server (server/server.mjs) ───────────────────────────────────────────────
# Port for the control relay + media bridge server.
WEB_OBS_PORT=8480

# Shared auth token. If unset the server generates a random one per boot and
# prints it to the console.
WEB_OBS_TOKEN=dev-token

# Optional: RTMP target. When set (and ffmpeg is installed), every program
# feed received on /bridge is remuxed and pushed to this URL.
# Example: rtmp://a.rtmp.youtube.com/live2/<stream-key>
RTMP_URL=

# Directory for local .webm recordings made via the bridge.
RECORD_DIR=recordings
